# ==========================================
# PayGuard Full-Stack Environment Variables
# ==========================================

# ── Backend (FastAPI) ─────────────────────

APP_NAME="PayGuard API"
APP_VERSION="1.0.0"
DEBUG=True
ENVIRONMENT="development" # Set to "production" in prod

# Database Connection (SQLite for dev, replace with Postgres for prod)
DATABASE_URL="sqlite+aiosqlite:///./payguard.db"
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/payguard"

# Redis Connection (For rate limiting / background tasks)
REDIS_URL="redis://localhost:6379/0"

# JWT Authentication
# IMPORTANT: Generate a strong secret key for production (e.g., `openssl rand -hex 32`)
JWT_SECRET_KEY="payguard-super-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (Allowed origins for the frontend)
CORS_ORIGINS='["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]'

# Machine Learning
ML_MODELS_DIR="../ml/models"
FRAUD_BLOCK_THRESHOLD=70

# Rate Limiting
RATE_LIMIT="100/minute"


# ── Frontend (Vite/React) ─────────────────

# The base URL pointing to the FastAPI backend
VITE_API_URL="http://localhost:8000"
